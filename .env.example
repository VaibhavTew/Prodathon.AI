# Copy to .env.local and fill in. Everything is optional for local development.

# Public URL of the site (used for SEO, emails and payment redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Admin ----------
# Enables /admin. Leave empty to disable the admin panel entirely.
ADMIN_PASSWORD=
# Optional separate secret used to sign the admin session cookie (defaults to ADMIN_PASSWORD).
ADMIN_SECRET=

# ---------- Storage ----------
# Folder for the JSON data store (content, registrations, enrollments, leads).
DATA_DIR=./data
# Optional: every new submission is also POSTed here as JSON
# (Zapier / Make / Google Apps Script → Google Sheets, Airtable, etc.)
FORM_WEBHOOK_URL=

# ---------- Payments ----------
# razorpay | stripe | mock   (auto-detected from keys if empty)
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
# Webhook secrets for /api/payments/webhook (confirms payment even if the student closes the tab)
RAZORPAY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
# The mock provider marks orders paid without charging. It is blocked in production unless this is "true".
ALLOW_MOCK_PAYMENTS=

# ---------- Email (Resend) ----------
# Without a key, emails are printed to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Prodathon <hello@prodathon.com>"
# Where internal notifications (new partner leads, contact messages, enrollments) go.
ADMIN_EMAIL=
